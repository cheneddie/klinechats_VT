{
  "name": "fabio-decision-gym",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "vendor:pixi": "node scripts/vendor-pixi.mjs",
    "predev": "pnpm run vendor:pixi",
    "dev": "vite --host 0.0.0.0",
    "server": "python -m server.fabio_api",
    "server:v4": "python -m server.fabio_api_v4",
    "server:v5": "python -m server.fabio_api_v5",
    "prebuild": "pnpm run vendor:pixi",
    "build": "node scripts/build-static.mjs",
    "prepreview": "pnpm run vendor:pixi",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:v5": "node --test tests/v5_product.test.mjs"
  },
  "dependencies": {
    "klinecharts": "10.0.2",
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  }
}
